generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── TENANCY ─────────────────────────────────────────────────────────────────

model Tenant {
  id              String   @id @default(cuid())
  name            String
  waNumber        String   @unique
  plan            Plan     @default(MULA)
  status          Status   @default(ACTIVE)
  aiPersonaConfig Json     @default("{}")
  checkoutMethods String[] @default(["qris"])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users         User[]
  products      Product[]
  customers     Customer[]
  conversations Conversation[]
  orders        Order[]
  subscriptions Subscription[]

  @@map("tenants")
}

model User {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  name         String
  email        String
  passwordHash String
  role         UserRole   @default(STAFF)
  permissions  Json       @default("{}")
  createdAt    DateTime   @default(now())

  assignedOrders Order[] @relation("AssignedOrders")

  @@unique([tenantId, email])
  @@map("users")
}

// ── CATALOG ──────────────────────────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  sku         String?
  price       Int
  costPrice   Int      @default(0)
  stock       Int      @default(0)
  category    String?
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]

  @@map("products")
}

// ── CUSTOMER & CONVERSATION ──────────────────────────────────────────────────

model Customer {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  waNumber    String
  name        String?
  address     String?
  notes       String?
  totalOrders Int      @default(0)
  totalSpent  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conversations Conversation[]
  orders        Order[]

  @@unique([tenantId, waNumber])
  @@map("customers")
}

model Conversation {
  id         String             @id @default(cuid())
  tenantId   String
  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  customerId String
  customer   Customer           @relation(fields: [customerId], references: [id])
  channel    Channel            @default(WHATSAPP)
  status     ConversationStatus @default(ACTIVE)
  assignedTo String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  messages Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           MessageRole
  content        String
  toolCalls      Json?
  createdAt      DateTime     @default(now())

  @@map("messages")
}

// ── ORDER & PAYMENT ──────────────────────────────────────────────────────────

model Order {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  status         OrderStatus   @default(PENDING_PAYMENT)
  totalAmount    Int
  checkoutMethod String        @default("qris")
  assignedToId   String?
  assignedTo     User?         @relation("AssignedOrders", fields: [assignedToId], references: [id])
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items   OrderItem[]
  payment Payment?

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  qty       Int
  unitPrice Int
  subtotal  Int

  @@map("order_items")
}

model Payment {
  id               String        @id @default(cuid())
  orderId          String        @unique
  order            Order         @relation(fields: [orderId], references: [id])
  method           String
  midtransToken    String?
  midtransOrderId  String?
  amount           Int
  status           PaymentStatus @default(PENDING)
  paidAt           DateTime?
  createdAt        DateTime      @default(now())

  @@map("payments")
}

// ── SUBSCRIPTION ─────────────────────────────────────────────────────────────

model Subscription {
  id                     String             @id @default(cuid())
  tenantId               String             @unique
  tenant                 Tenant             @relation(fields: [tenantId], references: [id])
  plan                   Plan
  status                 SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd       DateTime
  midtransSubscriptionId String?
  createdAt              DateTime           @default(now())

  @@map("subscriptions")
}

// ── ENUMS ─────────────────────────────────────────────────────────────────────

enum Plan {
  MULA
  TUMBUH
  JUARA
}

enum Status {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

enum Channel {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
}

enum ConversationStatus {
  ACTIVE
  CLOSED
  ESCALATED
}

enum MessageRole {
  CUSTOMER
  AI
  STAFF
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DONE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
}
