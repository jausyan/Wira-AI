# ─── AI ────────────────────────────────────────────────────
GROQ_API=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b

# ─── Database (Supabase: Settings > Database > Connection String > URI) ──
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# ─── Redis (Upstash: ioredis → REDIS_URL) ───────────────────
# Opsional — tanpa ini akan pakai in-memory context (hanya untuk dev)
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# ─── WhatsApp (Fonnte: dashboard > device > API token) ───────
FONNTE_TOKEN=xxxxxxxxxxxxxxxxxxxx

# ─── Midtrans (opsional untuk Phase 1) ──────────────────────
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# ─── App ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
